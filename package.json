{
  "name": "zcom-super-admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "vitest run",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:hex": "node scripts/check-hex.mjs",
    "lint:px": "node scripts/check-px.mjs --max 36",
    "validate:ops": "node scripts/validate-ops.mjs",
    "check:synced": "node scripts/check-synced-kit.mjs",
    "validate:contracts": "node ../zcom-backend/scripts/validate-clients/validate-clients.mjs src --client zcom-super-admin"
  },
  "dependencies": {
    "@apollo/client": "^3.14.1",
    "@heroui/react": "^2.8.10",
    "@internationalized/date": "3.12.0",
    "date-fns": "^3.6.0",
    "framer-motion": "^13.4.4",
    "graphql": "^16.14.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-date-range": "^2.0.1",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.18",
    "@types/react-date-range": "^1.4.10",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "@internationalized/date": "3.12.0"
  }
}
